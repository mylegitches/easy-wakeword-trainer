# Dockerfile.dev — unified image: data download + full training pipeline.
# Previously split into "dev" (UI only) and full; now merged into one image
# so training works out of the box.
FROM python:3.11-slim-bookworm

# System deps: git (clones), build-essential (piper-phonemize wheels),
# libsndfile1 + ffmpeg (audio decode for datasets library and librosa),
# wget/curl (fallback downloads)
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    wget \
    curl \
    build-essential \
    libsndfile1 \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Clone openWakeWord training codebase (pinned tag).
# IMPORTANT: clone into /app/oww-src, NOT /app/openwakeword.
# If the directory is named "openwakeword", Python's namespace importer picks
# it up as the package (CWD=/app) before the editable-install finder runs,
# producing a broken namespace package with no __init__.py content.
RUN git clone --depth 1 --branch v0.6.0 \
    https://github.com/dscripka/openWakeWord /app/oww-src

# Clone piper-sample-generator (training scripts; model weights live in /data volume)
RUN git clone --depth 1 --branch v2.0.0 \
    https://github.com/rhasspy/piper-sample-generator /app/piper-sample-generator

# ── Python deps ───────────────────────────────────────────────────────────
# Pin multiprocess/dill first to prevent pip backtracking from datasets' loose deps
RUN pip install --no-cache-dir multiprocess==0.70.15 dill==0.3.7

# Pin pyarrow/fsspec/huggingface-hub BEFORE installing datasets==2.14.6 so pip
# doesn't upgrade pyarrow to 14+ (which breaks datasets 2.14.6).
RUN pip install --no-cache-dir \
    "pyarrow==13.0.0" \
    "fsspec==2023.10.0" \
    "huggingface-hub==0.19.4"

# Full training + web stack (torch, speechbrain, onnx, fastapi, etc.)
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

# Audio decode libs needed by datasets/librosa during data download
RUN pip install --no-cache-dir soundfile librosa

# Install openWakeWord in editable mode so train.py is importable
RUN pip install --no-cache-dir -e /app/oww-src

# Patch DataLoader to num_workers=0 — avoids the >2GB IPC pipe limit when
# the ACAV features tensor is shared across worker subprocesses.
RUN python3 -c "\
path='/app/oww-src/openwakeword/train.py'; \
c=open(path).read(); \
c=c.replace('batch_size=None, num_workers=n_cpus, prefetch_factor=16','batch_size=None, num_workers=0'); \
open(path,'w').write(c); \
print('Patched train.py num_workers=0') \
"


# TFLite export (separate because it pulls keras/tf which can conflict with torch)
RUN pip install --no-cache-dir onnx2tf

# ── App code ──────────────────────────────────────────────────────────────
COPY app/ /app/app/
COPY scripts/ /app/scripts/
COPY make_validation_small.py /app/make_validation_small.py

RUN mkdir -p /outputs /data

ENV PYTHONUNBUFFERED=1
ENV DATA_DIR=/data
ENV OUTPUT_DIR=/outputs
ENV OPENWAKEWORD_DIR=/app/oww-src
ENV PIPER_GENERATOR_DIR=/app/piper-sample-generator

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
